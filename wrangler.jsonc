{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "franz-lernatelier",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-02",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/lehrperson/api/teacher/*",
      "/module/woche-36",
      "/module/woche-36/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ]
}
